# Copy to .env locally and fill in your own values. Never commit .env.

# Supabase (sign in / sign up / reviews) — safe to expose, protected by RLS
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Google Maps embed URL (Share → Embed a map → copy the src="…" link)
VITE_MAP_EMBED_URL=

# Telegram bookings — SERVER-SIDE ONLY (used by /api/book.js).
# Set these in Vercel → Settings → Environment Variables. Do NOT prefix with VITE_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local dev only (npm run dev): direct Telegram sending without the /api function.
# Never set these in Vercel.
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=
